# Railway подставит DATABASE_URL сам после добавления PostgreSQL к проекту
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Telegram
TELEGRAM_TOKEN=токен_из_BotFather
REVIEWS_CHAT_ID=-1001234567890
# Отдельный чат только для отзывов 1-3 звезды. Если не задан,
# негатив идёт в общий чат с отметкой 🚨
NEGATIVE_CHAT_ID=
TELEGRAM_ADMIN_CHAT=-1001234567890

# Почтовый ящик с уведомлениями площадок
IMAP_HOST=imap.mail.ru
IMAP_PORT=993
IMAP_USER=avdeev@fortuna2021.ru
IMAP_PASSWORD=пароль_приложения_а_не_от_аккаунта
IMAP_FOLDER=INBOX

# С какой даты брать письма. Без этого бот возьмёт вчерашние и новее,
# и архив в ящике останется нетронутым.
IMAP_SINCE=2026-10-15

# Google Таблица (п. 10 ТЗ). Без них выгрузка просто не работает,
# на сбор отзывов это не влияет.
# GOOGLE_CREDENTIALS_JSON — содержимое JSON-ключа сервисного аккаунта
# целиком, одной строкой. GOOGLE_SHEET_ID — из ссылки на таблицу:
# docs.google.com/spreadsheets/d/ВОТ_ЭТА_ЧАСТЬ/edit
GOOGLE_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Отзывы

# ИИ-черновики ответов (п. 9 ТЗ) через GigaChat. Без ключа кнопка
# «Подготовить ответ» просто скажет, что черновики не подключены.
# Ключ авторизации — в личном кабинете developers.sber.ru → GigaChat API.
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS — физлицо, GIGACHAT_API_B2B / _CORP — юрлицо
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat

# Голос бренда для черновиков
BRAND_NAME=Капучино
BRAND_KIND=сеть кафе-кондитерских в Волгограде
# Контакт для ответов на негатив (телефон или почта). Пусто — не указывается.
REPLY_CONTACT=
# Можно ли предлагать загладить вину при следующем визите: да / нет
REPLY_ALLOW_COMPENSATION=нет

# Как часто проверяем почту, в секундах
POLL_INTERVAL=300

TZ=Europe/Moscow
